# Copier ce fichier en .env.local et compléter. Ne jamais commiter .env.local.
# Valeurs locales : affichées par `npm run db:start` (supabase start).

# --- Public (exposé au navigateur, soumis à la RLS) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Serveur uniquement (jamais préfixé NEXT_PUBLIC_) ---
# Contourne la RLS : utilisé seulement par le seed, les tests et la mise à jour
# nocturne des prix indicatifs (/api/cron/prices).
SUPABASE_SERVICE_ROLE_KEY=
# Secret partagé avec Vercel Cron (au moins 16 caractères aléatoires).
CRON_SECRET=
# Phase 6 (IA). Laisser vide d'ici là.
ANTHROPIC_API_KEY=

# --- Tests de base de données ---
# Supabase local : postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
